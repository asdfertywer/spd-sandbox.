+	private final int max;
+
+	/**
+	 * @param steps the button increments, in display order. Negative steps are shown to the
+	 *              left of the value and positive ones to the right, e.g. -5, -1, 1, 5
+	 */
+	public SandboxStepper( String labelText, int min, int max, int... steps ){
+		super();
+
+		this.min = min;
+		this.max = max;
+
+		label = PixelScene.renderTextBlock(labelText, 7);
+		add(label);
+
+		value = PixelScene.renderTextBlock("0", 8);
+		add(value);
+
+		buttons = new RedButton[steps.length];
+		for (int i = 0; i < steps.length; i++){
+			final int step = steps[i];
+			buttons[i] = new RedButton((step > 0 ? "+" : "") + step, 7){
+				@Override
+				protected void onClick() {
+					int current = SandboxStepper.this.get();
+					int newValue = Math.max(SandboxStepper.this.min, Math.min(SandboxStepper.this.max, current + step));
+					if (newValue != current){
+						SandboxStepper.this.set(newValue);
+					}
+					SandboxStepper.this.layout();
+				}
+			};
+			add(buttons[i]);
+		}
+	}
+
+	protected abstract int get();
+
+	protected abstract void set( int newValue );
+
+	/** Re-reads the value from get() and redraws it. */
+	public void refresh(){
+		layout();
+	}
+
+	@Override
+	protected void layout() {
+		super.layout();
+
+		value.text(String.valueOf(get()));
+
+		float buttonsWidth = buttons.length * (BTN_WIDTH + GAP);
+		float labelWidth = Math.max(10, width - buttonsWidth - VALUE_WIDTH);
+
+		label.maxWidth((int) labelWidth);
+		label.setPos(x, y + (height - label.height()) / 2f);
+		PixelScene.align(label);
+
+		float cx = x + labelWidth;
+		int half = buttons.length / 2;
+
+		for (int i = 0; i < half; i++){
+			buttons[i].setRect(cx, y, BTN_WIDTH, height);
+			cx += BTN_WIDTH + GAP;
+		}
+
+		value.setPos(cx + (VALUE_WIDTH - value.width()) / 2f, y + (height - value.height()) / 2f);
+		PixelScene.align(value);
+		cx += VALUE_WIDTH;
+
+		for (int i = half; i < buttons.length; i++){
+			buttons[i].setRect(cx, y, BTN_WIDTH, height);
+			cx += BTN_WIDTH + GAP;
+		}
+	}
+}
