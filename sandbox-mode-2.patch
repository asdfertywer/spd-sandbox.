+package com.shatteredpixel.shatteredpixeldungeon.sandbox;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Hero;
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.items.Generator;
+import com.shatteredpixel.shatteredpixeldungeon.items.armor.Armor;
+import com.shatteredpixel.shatteredpixeldungeon.items.armor.ClassArmor;
+import com.shatteredpixel.shatteredpixeldungeon.items.scrolls.ScrollOfUpgrade;
+import com.shatteredpixel.shatteredpixeldungeon.items.wands.WandOfMagicMissile;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.Weapon;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.melee.MagesStaff;
+import com.shatteredpixel.shatteredpixeldungeon.messages.Messages;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.utils.Reflection;
+
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Arrays;
+
+/**
+ * Central helper for Sandbox Mode. Nothing here is used unless Dungeon.sandbox is true.
+ *
+ * Item catalogs are built from the game's own Generator categories (plus a few explicit lists of
+ * classes that exist in the code base), so every entry is a real, existing item class.
+ */
+public class SandboxMode {
+
+	public static final int START_GOLD   = 99999;
+	public static final int START_ENERGY = 99999;
+
+	public static final int MAX_LEVEL = 99;
+	public static final int MAX_QUANTITY = 999;
+
+	//defaults used by the item menu's "quick add" mode and pre-filled in the item window
+	public static boolean quickAdd = false;
+	public static int defaultLevel = 0;
+	public static int defaultQuantity = 1;
+
+	/** Called once, right after the hero was created for a brand new Sandbox run. */
+	public static void initRun( Hero hero ){
+		Dungeon.gold = START_GOLD;
+		Dungeon.energy = START_ENERGY;
+
+		//Scrolls of Upgrade are never consumed in sandbox mode, so a single one is enough
+		Item scroll = new ScrollOfUpgrade().identify();
+		scroll.collect();
+	}
+
+	// ------------------------------------------------------------------------------------------
+	// Item catalogs
+	// ------------------------------------------------------------------------------------------
+
+	public enum Category {
+		WEAPON,
+		ARMOR,
+		RING,
+		ARTIFACT,
+		MISSILE,
+		OTHER
+	}
+
+	/** A titled group of item classes, used to build sectioned lists. */
+	public static class Section {
+		public final String titleKey; //key in WndSandbox messages, or null for no title
+		public final ArrayList<Class<?>> classes = new ArrayList<>();
+
+		public Section( String titleKey, Class<?>... classes ){
+			this.titleKey = titleKey;
+			this.classes.addAll(Arrays.asList(classes));
+		}
+
+	}
+
+	public static ArrayList<Section> sections( Category category ){
+		ArrayList<Section> result = new ArrayList<>();
+
+		switch (category){
+			case WEAPON:
+				result.add(new Section("tier_1", Generator.Category.WEP_T1.classes));
+				result.add(new Section("tier_2", Generator.Category.WEP_T2.classes));
+				result.add(new Section("tier_3", Generator.Category.WEP_T3.classes));
+				result.add(new Section("tier_4", Generator.Category.WEP_T4.classes));
+				result.add(new Section("tier_5", Generator.Category.WEP_T5.classes));
+				break;
+
+			case ARMOR:
+				result.add(new Section(null, Generator.Category.ARMOR.classes));
+				break;
+
+			case RING:
+				result.add(new Section(null, Generator.Category.RING.classes));
+				break;
