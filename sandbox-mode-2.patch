+
+/**
+ * Lets the player change the hero's level, strength, max health, gold and alchemical energy.
+ */
+public class WndSandboxStats extends Window {
+
+	private static final int WIDTH = 140;
+	private static final int ROW_HEIGHT = 16;
+	private static final int GAP = 3;
+
+	public WndSandboxStats() {
+		super();
+
+		final Hero hero = Dungeon.hero;
+
+		RenderedTextBlock title = PixelScene.renderTextBlock(Messages.get(WndSandbox.class, "stats"), 9);
+		title.hardlight(TITLE_COLOR);
+		title.setPos((WIDTH - title.width()) / 2f, 1);
+		add(title);
+
+		float pos = title.bottom() + 4;
+
+		//Level
+		SandboxStepper level = new SandboxStepper(Messages.get(WndSandbox.class, "stat_level"),
+				1, Hero.MAX_LEVEL, -5, -1, 1, 5){
+			@Override
+			protected int get() {
+				return hero.lvl;
+			}
+
+			@Override
+			protected void set(int newValue) {
+				hero.lvl = newValue;
+				hero.exp = 0;
+				hero.updateHT(true);
+			}
+		};
+		add(level);
+		level.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT + GAP;
+
+		//Strength
+		SandboxStepper strength = new SandboxStepper(Messages.get(WndSandbox.class, "stat_str"),
+				1, 99, -5, -1, 1, 5){
+			@Override
+			protected int get() {
+				return hero.STR;
+			}
+
+			@Override
+			protected void set(int newValue) {
+				hero.STR = newValue;
+			}
+		};
+		add(strength);
+		strength.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT + GAP;
+
+		//Max health (on top of what the level gives, the same way potions of life do)
+		SandboxStepper health = new SandboxStepper(Messages.get(WndSandbox.class, "stat_hp"),
+				0, 9999, -50, -10, 10, 50){
+			@Override
+			protected int get() {
+				return hero.HTBoost;
+			}
+
+			@Override
+			protected void set(int newValue) {
+				hero.HTBoost = newValue;
+				hero.updateHT(true);
+			}
+		};
+		add(health);
+		health.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT + GAP;
+
+		//Gold
+		SandboxStepper gold = new SandboxStepper(Messages.get(WndSandbox.class, "stat_gold"),
+				0, 999999, -1000, -100, 100, 1000){
+			@Override
+			protected int get() {
+				return Dungeon.gold;
+			}
+
+			@Override
+			protected void set(int newValue) {
+				Dungeon.gold = newValue;
+			}
+		};
+		add(gold);
+		gold.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT + GAP;
+
+		//Alchemical energy (alchemy is free in sandbox mode anyway, this is only for display)
+		SandboxStepper energy = new SandboxStepper(Messages.get(WndSandbox.class, "stat_energy"),
+				0, 999999, -1000, -100, 100, 1000){
+			@Override
+			protected int get() {
+				return Dungeon.energy;
+			}
+
+			@Override
+			protected void set(int newValue) {
+				Dungeon.energy = newValue;
+			}
+		};
+		add(energy);
+		energy.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT + GAP;
+
+		RedButton btnHeal = new RedButton(Messages.get(WndSandbox.class, "heal"), 8){
+			@Override
+			protected void onClick() {
+				hero.HP = hero.HT;
+				if (hero.sprite != null){
+					hero.sprite.showStatus(com.shatteredpixel.shatteredpixeldungeon.sprites.CharSprite.POSITIVE,
+							Integer.toString(hero.HT));
+				}
+			}
+		};
+		add(btnHeal);
+		btnHeal.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT + GAP;
+
+		RedButton btnBack = new RedButton(Messages.get(WndSandbox.class, "back"), 8){
+			@Override
+			protected void onClick() {
+				hide();
+				GameScene.show(new WndSandbox());
+			}
+		};
+		add(btnBack);
+		btnBack.setRect(0, pos, WIDTH, ROW_HEIGHT);
+		pos += ROW_HEIGHT;
+
+		resize(WIDTH, (int) pos);
+	}
+}
