+package com.shatteredpixel.shatteredpixeldungeon.windows;
+
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.items.armor.Armor;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.Weapon;
+import com.shatteredpixel.shatteredpixeldungeon.messages.Messages;
+import com.shatteredpixel.shatteredpixeldungeon.sandbox.SandboxMode;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.PixelScene;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RenderedTextBlock;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+
+/**
+ * Window for one sandbox item. It is used in two ways:
+ *  - existing == false: a freshly made item that is configured (level, quantity, enchantment)
+ *    and then added to the inventory. The window stays open so several copies can be added.
+ *  - existing == true: an item the hero already carries/wears; changes apply immediately.
+ */
+public class WndSandboxItem extends Window {
+
+	private static final int WIDTH = 132;
+	private static final int ROW_HEIGHT = 16;
+	private static final int GAP = 3;
+
+	private Item item;
+	private final boolean existing;
+
+	private RenderedTextBlock status;
+
+	public WndSandboxItem( Item item, boolean existing ) {
+		super();
+
+		this.item = item;
+		this.existing = existing;
+
+		IconTitle title = new IconTitle(item);
+		title.setRect(0, 0, WIDTH, 0);
+		add(title);
+
+		float pos = title.bottom() + GAP;
+
+		status = PixelScene.renderTextBlock(6);
+		status.maxWidth(WIDTH);
+		status.setPos(0, pos);
+		add(status);
+		updateStatus();
+
+		//two lines are reserved so that the layout doesn't jump around when the text changes
+		pos += 14 + GAP;
+
+		if (item.isUpgradable()){
+			SandboxStepper level = new SandboxStepper(Messages.get(WndSandbox.class, "level"),
+					0, SandboxMode.MAX_LEVEL, -5, -1, 1, 5){
+				@Override
+				protected int get() {
+					return WndSandboxItem.this.item.level();
+				}
+
+				@Override
+				protected void set(int newValue) {
+					SandboxMode.setLevel(WndSandboxItem.this.item, newValue);
+					if (!WndSandboxItem.this.existing){
+						SandboxMode.defaultLevel = WndSandboxItem.this.item.level();
+					}
+					updateStatus();
+				}
+			};
+			add(level);
+			level.setRect(0, pos, WIDTH, ROW_HEIGHT);
+			pos += ROW_HEIGHT + GAP;
+		}
+
+		if (item.stackable){
+			SandboxStepper quantity = new SandboxStepper(Messages.get(WndSandbox.class, "quantity"),
+					1, SandboxMode.MAX_QUANTITY, -10, -1, 1, 10){
+				@Override
+				protected int get() {
+					return WndSandboxItem.this.item.quantity();
+				}
+
+				@Override
+				protected void set(int newValue) {
+					WndSandboxItem.this.item.quantity(newValue);
+					if (!WndSandboxItem.this.existing){
+						SandboxMode.defaultQuantity = newValue;
+					}
+					Item.updateQuickslot();
+				}
+			};
+			add(quantity);
+			quantity.setRect(0, pos, WIDTH, ROW_HEIGHT);
+			pos += ROW_HEIGHT + GAP;
+		}
+
+		if (item instanceof Weapon || item instanceof Armor){
+			RedButton btnEnchant = new RedButton(Messages.get(WndSandbox.class,
+					item instanceof Weapon ? "enchant_button" : "glyph_button"), 8){
+				@Override
+				protected void onClick() {
+					hide();
+					GameScene.show(new WndSandboxEnchant(WndSandboxItem.this.item, WndSandboxItem.this.existing, true));
+				}
+			};
+			btnEnchant.multiline = true;
+			add(btnEnchant);
+			btnEnchant.setRect(0, pos, WIDTH, ROW_HEIGHT);
+			pos += ROW_HEIGHT + GAP;
+		}
+
+		if (!existing){
+			RedButton btnAdd = new RedButton(Messages.get(WndSandbox.class, "add"), 9){
+				@Override
+				protected void onClick() {
+					addToInventory();
+				}
+			};
+			btnAdd.textColor(TITLE_COLOR);
+			add(btnAdd);
+			btnAdd.setRect(0, pos, WIDTH, ROW_HEIGHT + 2);
+			pos += ROW_HEIGHT + 2 + GAP;
+		}
+
+		resize(WIDTH, (int) (pos - GAP));
+	}
+
+	private void addToInventory(){
+		//the window keeps a copy (with the same level, quantity and enchantment)
+		//so that more of the same item can be added without reconfiguring it
+		Item toGive = item;
+		Item copy = toGive.duplicate();
+
+		SandboxMode.give(toGive);
+
+		if (copy == null){
+			hide();
+			return;
+		}
+		item = copy;
+		updateStatus();
+	}
+
+	private void updateStatus(){
+		StringBuilder sb = new StringBuilder();
+		if (item.isUpgradable()){
+			sb.append(Messages.get(WndSandbox.class, "status_level", item.level()));
+		}
+		String ench = SandboxMode.currentEnchantName(item);
+		if (ench != null){
+			if (sb.length() > 0) sb.append('\n');
+			sb.append(Messages.get(WndSandbox.class, item instanceof Weapon ? "status_enchant" : "status_glyph", ench));
+		}
+		status.text(sb.toString());
+	}
+}
