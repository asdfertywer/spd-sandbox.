+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.ScrollingListPane;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+
+/**
+ * Lists every weapon enchantment / armor glyph (including curses) for one item.
+ * Any of them can be applied to any weapon/armor, ignoring the usual restrictions,
+ * and replaced again as often as wanted.
+ */
+public class WndSandboxEnchant extends Window {
+
+	private static final int WIDTH_P  = 126;
+	private static final int HEIGHT_P = 180;
+	private static final int WIDTH_L  = 216;
+	private static final int HEIGHT_L = 130;
+
+	private static final int BTN_HEIGHT = 14;
+	private static final int GAP = 2;
+
+	private final Item item;
+	private final boolean existing;
+	private final boolean fromItemWindow;
+
+	/**
+	 * @param existing       whether the item is already in the hero's inventory
+	 * @param fromItemWindow if true, applying a choice (or going back) returns to the item window,
+	 *                       otherwise this window is simply shown again
+	 */
+	public WndSandboxEnchant( Item item, boolean existing, boolean fromItemWindow ) {
+		super();
+
+		this.item = item;
+		this.existing = existing;
+		this.fromItemWindow = fromItemWindow;
+
+		int width = PixelScene.landscape() ? WIDTH_L : WIDTH_P;
+		int height = Math.min(PixelScene.landscape() ? HEIGHT_L : HEIGHT_P, (int) (PixelScene.uiCamera.height * 0.9f));
+		resize(width, height);
+
+		IconTitle title = new IconTitle(item);
+		title.setRect(0, 0, width - 42, 0);
+		add(title);
+
+		RedButton btnBack = new RedButton(Messages.get(WndSandbox.class, "back"), 7){
+			@Override
+			protected void onClick() {
+				hide();
+				reopenParent();
+			}
+		};
+		add(btnBack);
+		btnBack.setRect(width - 40, 0, 40, BTN_HEIGHT);
+
+		float top = Math.max(title.bottom(), btnBack.bottom()) + GAP;
+
+		ScrollingListPane list = new ScrollingListPane();
+		add(list);
+		list.setRect(0, top, width, height - top);
+
+		Class<?> current = currentClass();
+
+		//entry that removes the current enchantment/glyph
+		ScrollingListPane.ListItem none = new ScrollingListPane.ListItem(
+				new ItemSprite(item), null, Messages.get(WndSandbox.class, "remove_enchant")){
+			@Override
+			public boolean onClick(float x, float y) {
+				if (inside(x, y)){
+					applyChoice(null);
+					return true;
+				}
+				return false;
+			}
+		};
+		if (current == null) none.hardlight(0x44FF44);
+		list.addItem(none);
+
+		for (SandboxMode.Section section : SandboxMode.enchantSections(item)){
+			list.addTitle(Messages.get(WndSandbox.class, section.titleKey));
+
+			for (final Class<?> cls : section.classes){
+				ScrollingListPane.ListItem entry = new ScrollingListPane.ListItem(
+						new ItemSprite(item), null, SandboxMode.enchantName(cls)){
+					@Override
+					public boolean onClick(float x, float y) {
+						if (inside(x, y)){
+							applyChoice(cls);
+							return true;
+						}
+						return false;
+					}
+				};
+				if (cls == current) entry.hardlight(0x44FF44);
+				list.addItem(entry);
+			}
+		}
+
+		list.setRect(0, top, width, height - top);
+	}
+
+	private Class<?> currentClass(){
+		if (item instanceof Weapon && ((Weapon) item).enchantment != null){
+			return ((Weapon) item).enchantment.getClass();
+		} else if (item instanceof Armor && ((Armor) item).glyph != null){
+			return ((Armor) item).glyph.getClass();
+		}
+		return null;
+	}
+
+	private void applyChoice( Class<?> cls ){
+		SandboxMode.applyEnchant(item, cls);
+		GLog.p(Messages.get(WndSandbox.class, cls == null ? "enchant_removed" : "enchant_applied",
+				cls == null ? item.name() : SandboxMode.currentEnchantName(item)));
+		hide();
+		if (fromItemWindow){
+			reopenParent();
+		} else {
+			GameScene.show(new WndSandboxEnchant(item, existing, false));
+		}
+	}
+
+	private void reopenParent(){
+		if (fromItemWindow){
+			GameScene.show(new WndSandboxItem(item, existing));
+		} else {
+			GameScene.show(new WndSandbox());
+		}
+	}
+}
