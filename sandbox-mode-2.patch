+
+/**
+ * Main menu of Sandbox Mode: one button per category of the sandbox tools.
+ * Opened from the in-game menu (WndGame) while playing a Sandbox run.
+ */
+public class WndSandbox extends Window {
+
+	private static final int WIDTH = 150;
+	private static final int BTN_HEIGHT = 18;
+	private static final int GAP = 2;
+
+	private float pos;
+	private int column = 0;
+
+	public WndSandbox() {
+		super();
+
+		RenderedTextBlock title = PixelScene.renderTextBlock(Messages.get(this, "title"), 9);
+		title.hardlight(TITLE_COLOR);
+		title.setPos((WIDTH - title.width()) / 2f, GAP);
+		add(title);
+
+		pos = title.bottom() + 4;
+
+		addCategory("weapons", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxList(SandboxMode.Category.WEAPON));
+			}
+		});
+
+		addCategory("armor", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxList(SandboxMode.Category.ARMOR));
+			}
+		});
+
+		addCategory("enchants", new Runnable() {
+			@Override
+			public void run() {
+				selectItemFor(true);
+			}
+		});
+
+		addCategory("upgrade_scrolls", new Runnable() {
+			@Override
+			public void run() {
+				Item scroll = new ScrollOfUpgrade().identify();
+				SandboxMode.prefill(scroll);
+				GameScene.show(new WndSandboxItem(scroll, false));
+			}
+		});
+
+		addCategory("artifacts", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxList(SandboxMode.Category.ARTIFACT));
+			}
+		});
+
+		addCategory("rings", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxList(SandboxMode.Category.RING));
+			}
+		});
+
+		addCategory("missiles", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxList(SandboxMode.Category.MISSILE));
+			}
+		});
+
+		addCategory("other", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxList(SandboxMode.Category.OTHER));
+			}
+		});
+
+		addCategory("edit_item", new Runnable() {
+			@Override
+			public void run() {
+				selectItemFor(false);
+			}
+		});
+
+		addCategory("stats", new Runnable() {
+			@Override
+			public void run() {
+				GameScene.show(new WndSandboxStats());
+			}
+		});
+
+		addCategory("alchemy", new Runnable() {
+			@Override
+			public void run() {
+				AlchemyScene.clearToolkit();
+				ShatteredPixelDungeon.switchScene(AlchemyScene.class);
+			}
+		});
+
+		if (column == 1) pos += BTN_HEIGHT + GAP;
+
+		resize(WIDTH, (int) pos);
+	}
+
+	private void addCategory( String key, final Runnable action ){
+		float btnWidth = (WIDTH - GAP) / 2f;
+
+		RedButton btn = new RedButton(Messages.get(this, key), 8){
+			@Override
+			protected void onClick() {
+				hide();
+				action.run();
+			}
+		};
+		btn.multiline = true;
+		add(btn);
+		btn.setRect(column == 0 ? 0 : btnWidth + GAP, pos, btnWidth, BTN_HEIGHT);
+
+		if (column == 0){
+			column = 1;
+		} else {
+			column = 0;
+			pos += BTN_HEIGHT + GAP;
+		}
+	}
+
+	/**
+	 * Lets the player pick one of the items they carry (or wear), and then opens either the
+	 * enchantment/glyph picker or the item editor for it.
+	 */
+	private void selectItemFor( final boolean enchantOnly ){
+		GameScene.selectItem(new WndBag.ItemSelector() {
+			@Override
+			public String textPrompt() {
+				return Messages.get(WndSandbox.class, enchantOnly ? "pick_enchantable" : "pick_item");
+			}
+
+			@Override
+			public boolean itemSelectable(Item item) {
+				if (enchantOnly){
+					return item instanceof Weapon || item instanceof Armor;
+				}
+				return true;
+			}
+
+			@Override
+			public void onSelect(Item item) {
+				if (item == null) return;
+				if (enchantOnly){
+					GameScene.show(new WndSandboxEnchant(item, true, false));
+				} else {
+					GameScene.show(new WndSandboxItem(item, true));
+				}
+			}
+		});
+	}
+}
