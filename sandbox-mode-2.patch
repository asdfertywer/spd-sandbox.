+/**
+ * A single row used by the sandbox windows: "label  [-5][-1] value [+1][+5]".
+ * Subclasses provide the value through get() and receive changes through set().
+ */
+public abstract class SandboxStepper extends Component {
+
+	private static final float BTN_WIDTH = 17f;
+	private static final float VALUE_WIDTH = 24f;
+	private static final float GAP = 1f;
+
+	private final RenderedTextBlock label;
