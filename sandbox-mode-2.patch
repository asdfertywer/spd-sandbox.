+package com.shatteredpixel.shatteredpixeldungeon.windows;
+
+import com.shatteredpixel.shatteredpixeldungeon.ShatteredPixelDungeon;
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.messages.Messages;
+import com.shatteredpixel.shatteredpixeldungeon.sandbox.SandboxMode;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.PixelScene;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.ItemSprite;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RenderedTextBlock;
+import com.shatteredpixel.shatteredpixeldungeon.ui.ScrollingListPane;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+
+import java.util.ArrayList;
+import java.util.Locale;
+
+/**
+ * Searchable, scrollable list of every item of one sandbox category.
+ * Tapping an entry opens the item window, or (with "quick add" switched on) adds it right away.
+ */
+public class WndSandboxList extends Window {
+
+	private static final int WIDTH_P  = 126;
+	private static final int HEIGHT_P = 180;
+	private static final int WIDTH_L  = 216;
+	private static final int HEIGHT_L = 130;
+
+	private static final int BTN_HEIGHT = 16;
+	private static final int GAP = 2;
+
+	private static class Entry {
+		String titleKey;               //non-null for section headers
+		Class<?> cls;                  //non-null for items
+		Item sample;                   //only used for the name and the icon
+	}
+
+	private final SandboxMode.Category category;
+	private final ArrayList<Entry> entries = new ArrayList<>();
+
+	private String query = "";
+
+	private final ScrollingListPane list;
+	private final RedButton btnSearch;
+	private final RedButton btnQuick;
+
+	public WndSandboxList( SandboxMode.Category category ) {
+		super();
+
+		this.category = category;
+
+		int width = PixelScene.landscape() ? WIDTH_L : WIDTH_P;
+		int height = Math.min(PixelScene.landscape() ? HEIGHT_L : HEIGHT_P, (int) (PixelScene.uiCamera.height * 0.9f));
+		resize(width, height);
+
+		//build the catalog once, searching only filters it
+		for (SandboxMode.Section section : SandboxMode.sections(category)){
+			if (section.titleKey != null){
+				Entry header = new Entry();
+				header.titleKey = section.titleKey;
+				entries.add(header);
+			}
+			for (Class<?> cls : section.classes){
+				Item sample = SandboxMode.create(cls);
+				if (sample == null) continue;
+				Entry e = new Entry();
+				e.cls = cls;
+				e.sample = sample;
+				entries.add(e);
+			}
+		}
+
+		RenderedTextBlock title = PixelScene.renderTextBlock(categoryTitle(), 9);
+		title.hardlight(TITLE_COLOR);
+		title.setPos(0, 1);
+		add(title);
+
+		RedButton btnBack = new RedButton(Messages.get(WndSandbox.class, "back"), 7){
+			@Override
+			protected void onClick() {
+				hide();
+				GameScene.show(new WndSandbox());
+			}
+		};
+		add(btnBack);
+		btnBack.setRect(width - 40, 0, 40, 12);
+
+		float top = Math.max(title.bottom(), btnBack.bottom()) + GAP;
+
+		btnSearch = new RedButton(Messages.get(WndSandbox.class, "search"), 7){
+			@Override
+			protected void onClick() {
+				ShatteredPixelDungeon.scene().addToFront(new WndTextInput(
+						Messages.get(WndSandbox.class, "search_title"),
+						Messages.get(WndSandbox.class, "search_desc"),
+						query,
+						30,
+						false,
+						Messages.get(WndSandbox.class, "search_ok"),
+						Messages.get(WndSandbox.class, "search_clear")){
+					@Override
+					public void onSelect(boolean positive, String text) {
+						query = positive && text != null ? text.trim().toLowerCase(Locale.ROOT) : "";
+						updateSearchButton();
+						refill();
+					}
+				});
+			}
+		};
+		add(btnSearch);
+		btnSearch.setRect(0, top, width - 60 - GAP, BTN_HEIGHT);
+
+		btnQuick = new RedButton("", 7){
+			@Override
+			protected void onClick() {
+				SandboxMode.quickAdd = !SandboxMode.quickAdd;
+				updateQuickButton();
+			}
+		};
+		add(btnQuick);
+		btnQuick.setRect(width - 60, top, 60, BTN_HEIGHT);
+
+		top += BTN_HEIGHT + GAP;
+
+		list = new ScrollingListPane();
+		add(list);
+		list.setRect(0, top, width, height - top);
+
+		updateSearchButton();
+		updateQuickButton();
+		refill();
+	}
+
+	private String categoryTitle(){
+		switch (category){
+			case WEAPON:   return Messages.get(WndSandbox.class, "weapons");
+			case ARMOR:    return Messages.get(WndSandbox.class, "armor");
+			case RING:     return Messages.get(WndSandbox.class, "rings");
+			case ARTIFACT: return Messages.get(WndSandbox.class, "artifacts");
+			case MISSILE:  return Messages.get(WndSandbox.class, "missiles");
+			default:       return Messages.get(WndSandbox.class, "other");
+		}
+	}
+
+	private void updateSearchButton(){
+		if (query.isEmpty()){
+			btnSearch.text(Messages.get(WndSandbox.class, "search"));
+		} else {
+			btnSearch.text(Messages.get(WndSandbox.class, "search") + ": " + query);
+		}
+	}
+
+	private void updateQuickButton(){
+		btnQuick.text(Messages.get(WndSandbox.class, SandboxMode.quickAdd ? "quick_on" : "quick_off"));
+	}
+
+	/** Rebuilds the visible list according to the current search text. */
+	private void refill(){
+		list.clear();
+
+		//headers are only shown when at least one item under them matches
+		Entry pendingHeader = null;
+		boolean any = false;
+
+		for (final Entry e : entries){
+			if (e.titleKey != null){
+				pendingHeader = e;
+				continue;
+			}
+
+			if (!query.isEmpty() && !e.sample.name().toLowerCase(Locale.ROOT).contains(query)){
+				continue;
+			}
+
+			if (pendingHeader != null){
+				list.addTitle(Messages.get(WndSandbox.class, pendingHeader.titleKey));
+				pendingHeader = null;
+			}
+
+			ScrollingListPane.ListItem item = new ScrollingListPane.ListItem(
+					new ItemSprite(e.sample), null, Messages.titleCase(e.sample.name())){
+				@Override
+				public boolean onClick(float x, float y) {
+					if (inside(x, y)){
+						onItemTapped(e.cls);
+						return true;
+					}
+					return false;
+				}
+			};
+			list.addItem(item);
+			any = true;
+		}
+
+		if (!any){
+			list.addTitle(Messages.get(WndSandbox.class, "no_results"));
+		}
+
+		list.setRect(list.left(), list.top(), list.width(), list.height());
+		list.scrollTo(0, 0);
+	}
+
+	private void onItemTapped( Class<?> cls ){
+		Item item = SandboxMode.prefill(SandboxMode.create(cls));
+		if (item == null) return;
+
+		if (SandboxMode.quickAdd){
+			SandboxMode.give(item);
+		} else {
+			GameScene.show(new WndSandboxItem(item, false));
+		}
+	}
+}
