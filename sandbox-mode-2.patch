+	/**
+	 * Creates a fresh, identified instance of the given item class, or null if the class
+	 * can't (or shouldn't) be instantiated by the menu.
+	 */
+	public static Item create( Class<?> cls ){
+		if (cls == null || Modifier.isAbstract(cls.getModifiers())) return null;
+		if (!Item.class.isAssignableFrom(cls)) return null;
+		//class armors are only ever created by transforming an armor, using the hero's armor ability
+		if (ClassArmor.class.isAssignableFrom(cls)) return null;
+
+		Item item;
+		if (cls == MagesStaff.class){
+			item = new MagesStaff(new WandOfMagicMissile());
+		} else {
+			item = (Item) Reflection.newInstance(cls);
+		}
+		if (item == null) return null;
+
+		item.identify(false);
+		item.cursed = false;
+		return item;
+	}
+
+	/** Builds all items of a section (skipping classes that can't be created). */
+	public static ArrayList<Item> createAll( Section section ){
+		ArrayList<Item> items = new ArrayList<>();
+		for (Class<?> cls : section.classes){
+			Item item = create(cls);
+			if (item != null) items.add(item);
+		}
+		return items;
+	}
+
+	// ------------------------------------------------------------------------------------------
+	// Item manipulation
+	// ------------------------------------------------------------------------------------------
+
+	/** Applies the menu's current default level/quantity to a freshly created item. */
+	public static Item prefill( Item item ){
+		if (item == null) return null;
+		if (item.isUpgradable()) setLevel(item, defaultLevel);
+		if (item.stackable) item.quantity(Math.max(1, Math.min(MAX_QUANTITY, defaultQuantity)));
+		return item;
+	}
+
+	/** Sets the upgrade level using the item's own upgrade/degrade logic. */
+	public static void setLevel( Item item, int target ){
+		if (!item.isUpgradable()) return;
+		target = Math.max(0, Math.min(MAX_LEVEL, target));
+
+		int guard = 0;
+		while (item.level() < target && guard++ < 200) item.upgrade();
+		while (item.level() > target && guard++ < 400) item.degrade();
+		item.cursed = false;
+		item.identify(false);
+	}
+
+	/** Adds an item to the hero's pack, or drops it at the hero's feet when the pack is full. */
+	public static void give( Item item ){
+		Hero hero = Dungeon.hero;
+		if (hero == null || item == null) return;
+
+		String name = item.name();
+		if (!item.collect()){
+			Dungeon.level.drop(item, hero.pos);
+		}
+		GLog.p(Messages.get(SandboxMode.class, "added", name));
+	}
+
+	/** Weapon enchantments / armor glyphs usable by the enchantment menu, grouped by rarity. */
+	public static ArrayList<Section> enchantSections( Item item ){
+		ArrayList<Section> result = new ArrayList<>();
+		if (item instanceof Weapon){
+			result.add(new Section("common", Weapon.Enchantment.common));
+			result.add(new Section("uncommon", Weapon.Enchantment.uncommon));
+			result.add(new Section("rare", Weapon.Enchantment.rare));
+			result.add(new Section("curses", Weapon.Enchantment.curses));
+		} else if (item instanceof Armor){
+			result.add(new Section("common", Armor.Glyph.common));
+			result.add(new Section("uncommon", Armor.Glyph.uncommon));
+			result.add(new Section("rare", Armor.Glyph.rare));
+			result.add(new Section("curses", Armor.Glyph.curses));
+		}
+		return result;
+	}
+
+	/** Applies (or, for a null class, removes) an enchantment/glyph, ignoring all usual restrictions. */
+	public static void applyEnchant( Item item, Class<?> cls ){
+		if (item instanceof Weapon){
+			Weapon w = (Weapon) item;
+			if (cls == null){
+				w.enchant(null);
+			} else {
+				w.enchant((Weapon.Enchantment) Reflection.newInstance(cls));
+			}
+			w.identify(false);
+		} else if (item instanceof Armor){
+			Armor a = (Armor) item;
+			if (cls == null){
+				a.inscribe(null);
+			} else {
+				a.inscribe((Armor.Glyph) Reflection.newInstance(cls));
+			}
+			a.identify(false);
+		}
+		Item.updateQuickslot();
+	}
+
+	/** Display name of the enchantment/glyph currently on the item, or null. */
+	public static String currentEnchantName( Item item ){
+		if (item instanceof Weapon && ((Weapon) item).enchantment != null){
+			return ((Weapon) item).enchantment.name("~");
+		} else if (item instanceof Armor && ((Armor) item).glyph != null){
+			return ((Armor) item).glyph.name("~");
+		}
+		return null;
+	}
+
+	public static String enchantName( Class<?> cls ){
+		if (Weapon.Enchantment.class.isAssignableFrom(cls)){
+			return ((Weapon.Enchantment) Reflection.newInstance(cls)).name("~");
+		} else if (Armor.Glyph.class.isAssignableFrom(cls)){
+			return ((Armor.Glyph) Reflection.newInstance(cls)).name("~");
+		}
+		return cls.getSimpleName();
+	}
+}
